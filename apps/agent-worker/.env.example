# Illustrative nonsecret defaults. Node/Railway inject these into the environment.
# The worker does not read a frontend .env or accept signing keys.
AGENT_NETWORK=hideki
AGENT_MODE=DRY_RUN
AGENT_STORE_PATH=data/agent-studio.sqlite
AGENT_POLL_MS=30000
AGENT_LEASE_TTL_MS=45000
AGENT_DATA_TIMEOUT_MS=20000
# Optional reviewed nonsecret JSON exported from Agent Studio:
# AGENT_CONFIG_FILE=data/agent.json
# Optional bounded read-only verification; omit for continuous observation:
# AGENT_MAX_CYCLES=1
